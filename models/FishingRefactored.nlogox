<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code>breed [fishers fisher]
patches-own [fish]
globals [total-fish catch-per-tick catch-per-fisher]

to setup
  clear-all
  resize-world 0 29 0 19  ; водойма 30 x 20 клітинок
  ask patches [set fish random (max-fish-stock + 1)]
  create-fishers number-of-fishers [
    move-to one-of patches
    set shape "person"
    set color red
  ]
  update-metrics
  update-colors
  reset-ticks
end

to go
  set catch-per-tick 0
  ask fishers [
    move-fisher
    catch-fish
  ]
  ask patches [regrowth-fish]
  update-metrics
  update-colors
  tick
end

; Дії рибалки
to move-fisher
  move-to one-of neighbors
end

to catch-fish
  let caught round (fish * catch-rate)
  set fish fish - caught
  set catch-per-tick catch-per-tick + caught
end

; Відновлення запасу на клітинці
to regrowth-fish
  ; Лінійний варіант: set fish fish + round (regrowth-rate * (max-fish-stock - fish))
  set fish fish + round (regrowth-rate * fish * (1 - fish / max-fish-stock))
end

; Показники та візуалізація
to update-metrics
  set total-fish sum [fish] of patches
  ifelse any? fishers
    [set catch-per-fisher catch-per-tick / count fishers]
    [set catch-per-fisher 0]
end

to update-colors
  ask patches [
    ; 7 рівнів: від світло-блакитного до темно-синього
    let level min (list 6 (floor (7 * fish / max-fish-stock)))
    set pcolor item level [108 107 106 105 104 103 102]
  ]
end
</code>
