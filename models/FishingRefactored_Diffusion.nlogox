<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code>breed [fishers fisher]
patches-own [fish]
globals [total-fish catch-per-tick catch-per-fisher]

to setup
  clear-all
  resize-world 0 29 0 19  ; водойма 30 x 20 клітинок
  ask patches [set fish random-float max-fish-stock]
  create-fishers number-of-fishers [
    move-to one-of patches
    set shape "person"
    set color red
  ]
  update-metrics
  update-colors
  reset-ticks
end

to go
  set catch-per-tick 0
  ask fishers [
    move-fisher
    catch-fish
  ]
  migrate-fish
  ask patches [regrowth-fish]
  update-metrics
  update-colors
  tick
end

; Дії рибалки
to move-fisher
  move-to one-of neighbors
end

to catch-fish
  let caught fish * catch-rate
  set fish fish - caught
  set catch-per-tick catch-per-tick + caught
end

; Рівномірний розподіл риби між поточною та 8 сусідніми клітинками
to migrate-fish
  diffuse fish (8 / 9)  ; частки для відсутніх сусідів залишаються на місці
end

; Відновлення запасу на клітинці
to regrowth-fish
  ; Лінійний варіант: set fish fish + regrowth-rate * (max-fish-stock - fish)
  set fish fish + regrowth-rate * fish * (1 - fish / max-fish-stock)
end

; Показники та візуалізація
to update-metrics
  set total-fish sum [fish] of patches
  ifelse any? fishers
    [set catch-per-fisher catch-per-tick / count fishers]
    [set catch-per-fisher 0]
end

to update-colors
  ask patches [
    ; 7 рівнів: від світло-блакитного до темно-синього
    let level min (list 6 (floor (7 * fish / max-fish-stock)))
    set pcolor item level [108 107 106 105 104 103 102]
  ]
end
</code>
  <widgets>
    <view x="270" wrappingAllowedX="false" y="10" frameRate="15.0" minPycor="0" height="325" showTickCounter="true" patchSize="16.0" fontSize="12" wrappingAllowedY="false" width="485" tickCounterLabel="ticks" maxPycor="19" updateMode="1" maxPxcor="29" minPxcor="0"></view>
    <slider x="12" step="1" y="69" max="100" display="number-of-fishers" height="37" min="0" direction="Horizontal" default="11.0" variable="number-of-fishers" width="240" sizeVersion="0"></slider>
    <slider x="12" step="0.005" y="204" max="0.1" display="regrowth-rate" height="37" min="0" direction="Horizontal" default="0.015" variable="regrowth-rate" width="240" sizeVersion="0"></slider>
    <slider x="10" step="0.01" y="160" max="1" display="catch-rate" height="37" min="0" direction="Horizontal" default="0.17" variable="catch-rate" width="240" sizeVersion="0"></slider>
    <slider x="12" step="10" y="115" max="200" display="max-fish-stock" height="37" min="10" direction="Horizontal" default="60.0" variable="max-fish-stock" width="240" sizeVersion="0"></slider>
    <note x="12" y="256" backgroundDark="-822083584" fontSize="13" width="246" markdown="false" height="80" textColorDark="-1" textColorLight="-16777216" backgroundLight="436207616">Темніше — більше риби.
Світліше — менше риби.

Червоні фігури — рибалки.</note>
