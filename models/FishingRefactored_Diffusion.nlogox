  <previewCommands>setup
repeat 50 [go]</previewCommands>
  <experiments>
    <experiment name="experiment" repetitions="20" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="500">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>total-fish</metric>
        <metric>total-fish / (count patches * max-fish-stock)</metric>
        <metric>catch-per-tick</metric>
        <metric>catch-per-fisher</metric>
        <metric>count patches with [fish = 0]</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="number-of-fishers" first="0" step="10" last="100"></steppedValueSet>
        <enumeratedValueSet variable="catch-rate">
          <value value="0"></value>
          <value value="0.05"></value>
          <value value="0.1"></value>
          <value value="0.15"></value>
          <value value="0.2"></value>
          <value value="0.3"></value>
          <value value="0.5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="max-fish-stock">
          <value value="60"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
