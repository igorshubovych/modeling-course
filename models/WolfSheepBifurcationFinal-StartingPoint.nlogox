  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="wolf-efficiency sweep" repetitions="20" sequentialRunOrder="false" runMetricsEveryStep="false" timeLimit="1500">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>outcome</metric>
        <metric>ticks</metric>
        <metric>count wolves</metric>
        <metric>count sheep</metric>
        <metric>sum [ grass ] of patches</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="initial-sheep">
          <value value="250"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-wolves">
          <value value="25"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="wolf-efficiency" first="1" step="1" last="20"></steppedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
