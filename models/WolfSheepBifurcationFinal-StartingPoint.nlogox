<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[globals [ outcome ]

breed [ sheep a-sheep ]
breed [ wolves wolf ]

patches-own [ grass ]

to setup
  clear-all
  set outcome "running"
  reset-ticks
end

to go
  tick
end]]></code>
